# Clinical Decision Support System (CDSS) -- Environment Variables Template
# Copy this file to '.env' and populate with your credentials.

# Google Gemini API Key (Required for Gemini model access)
# Generate a new API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative LLM Providers
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here
